{
  "name": "elanevelas",
  "version": "1.0.0",
  "type": "module",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "nodemon backend/src/server.js",
    "check": "node --check backend/src/server.js && node --check backend/src/app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "images:migrate": "node backend/scripts/images.js migrate",
    "images:cleanup": "node backend/scripts/images.js cleanup",
    "docker:mongo:up": "docker compose up -d mongodb",
    "docker:mongo:down": "docker compose down",
    "docker:mongo:logs": "docker compose logs -f mongodb"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "API do projeto Elane Velas, construída com Express e MongoDB.",
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1",
    "multer": "^2.3.0",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
